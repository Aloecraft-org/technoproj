{
  "TECHNO_VERSION": {
    "major": 0,
    "minor": 3,
    "patch": 0,
    "pre": null
  },
  "TECHNO_CHANGELOG": {
    "project": "technoproj",
    "tag_rule": "exact",
    "emit_json": false,
    "stamps": [
      {
        "file": "pyproject.toml",
        "find": "^version\\s*=\\s*\"([^\"]+)\"",
        "spelling": "pep440"
      }
    ],
    "latest_requires": [
      "stable"
    ]
  },
  "TECHNO_RELEASE": {
    "workflow": "release.yml",
    "name": "technoproj {tag}",
    "artifacts": "dist-*",
    "dev_builds": true
  },
  "TECHNO_INIT_DIRS": [
    ".nogit",
    ".dump",
    "script"
  ],
  "TECHNO_COPYRIGHT": "Copyright Michael Godfrey [2026] | aloecraft.org [michael@aloecraft.org]"
}
