{
  "project": "DRT",
  "intro_extra": "\nDRT versions independently of diluvium and *records* the coupling\nrather than encoding it: each entry names the dv ABI it speaks and\nthe diluvium revision it embeds, the same facts `BUILDINFO.txt`\ncarries in the release. See `doc/Release.md`.\n",
  "facts": [
    {"id": "dv_abi", "keys": ["dv_abi"], "fmt": "dv ABI {dv_abi}"},
    {"id": "dil", "keys": ["diluvium", "diluvium_build"], "fmt": "diluvium `{diluvium!s:.12}` (build{diluvium_build})"},
    {"id": "dil", "keys": ["diluvium"], "fmt": "diluvium `{diluvium!s:.12}`"}
  ],
  "mappings": [
    {"key": "connectors", "title": "Connectors"},
    {"key": "features", "title": "Core features"}
  ],
  "tag_rule": "exact",
  "stamps": [
    {"file": "Cargo.toml", "find": "version\\s*=\\s*\"(\\d+\\.\\d+\\.\\d+)\"", "spelling": "base"},
    {"file": "crates/drt-web/Cargo.toml", "find": "version\\s*=\\s*\"(\\d+\\.\\d+\\.\\d+)\"", "spelling": "base"}
  ]
}
